{
  "name": "real-estate-portfolio",
  "version": "1.0.0",
  "type": "module",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/vite/bin/vite.js --port 8081",
    "web": "node --use-system-ca ./node_modules/vite/bin/vite.js --port 8081",
    "build": "tsc && vite build",
    "test": "tsc -p tsconfig.tests.json && powershell -NoProfile -Command \"$pkg = Join-Path '.tmp-tests' 'package.json'; Set-Content -LiteralPath $pkg -Value '{\\\"type\\\":\\\"commonjs\\\"}' -NoNewline; node --test .tmp-tests/tests/*.test.js; Remove-Item -Recurse -Force .tmp-tests\"",
    "i18n:audit": "tsc --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck --outDir .tmp-i18n-audit scripts/i18n-audit.ts && powershell -NoProfile -Command \"$pkg = Join-Path '.tmp-i18n-audit' 'package.json'; Set-Content -LiteralPath $pkg -Value '{\\\"type\\\":\\\"commonjs\\\"}' -NoNewline; node .tmp-i18n-audit/scripts/i18n-audit.js; Remove-Item -Recurse -Force .tmp-i18n-audit\"",
    "preview": "node --use-system-ca ./node_modules/vite/bin/vite.js preview",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build-android": "eas build --platform android",
    "build-ios": "eas build --platform ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "expo": "^50.0.0",
    "expo-splash-screen": "~0.26.4",
    "expo-status-bar": "~1.11.1",
    "lucide-react": "^0.263.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-safe-area-context": "4.7.4",
    "react-native-screens": "~3.27.0",
    "react-native-web": "~0.19.10",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@types/react": "~18.2.45",
    "@types/react-native": "~0.73.0",
    "typescript": "^5.3.3",
    "tailwindcss": "^3.3.6",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.8",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "fake-indexeddb": "^6.2.5"
  },
  "private": true,
  "expo": {
    "name": "Real Estate Portfolio",
    "slug": "real-estate-portfolio",
    "version": "1.0.0",
    "scheme": "myapp",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTabletMode": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
