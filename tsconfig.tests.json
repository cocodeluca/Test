{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "outDir": ".tmp-tests"
  },
  "include": [
    "tests/**/*.ts",
    "src/common/**/*.ts",
    "src/platforms/web/services/localAccountStore.ts",
    "src/platforms/web/services/galleryMediaStore.ts"
  ]
}
